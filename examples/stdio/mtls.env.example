NIFI_API_URL=https://nifi.example.internal/nifi-api
NIFI_TRANSPORT=stdio
NIFI_AUTH=mtls
NIFI_CLIENT_CERT=/path/to/user.crt
NIFI_CLIENT_KEY=/path/to/user.key
# Optional password for an encrypted PEM key. Empty means an unencrypted key.
NIFI_CLIENT_KEY_PASSWORD=
# Set this to your CA bundle if NiFi's CA is not in your default trust store.
NIFI_CA_BUNDLE=
