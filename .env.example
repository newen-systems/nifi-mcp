# Copy to .env (gitignored), mode 0600. Exported variables override this file.
# Keycloak + VS Code HTTP: each caller retains their own NiFi policies.
NIFI_API_URL=https://nifi.example.internal/nifi-api
NIFI_AUTH=passthrough
NIFI_TRANSPORT=streamable-http
NIFI_HOST=127.0.0.1
NIFI_PORT=8000
NIFI_OAUTH_ISSUER_URL=https://keycloak.example.internal/realms/local
NIFI_OAUTH_RESOURCE_URL=https://nifi-mcp.example.internal/mcp
NIFI_OAUTH_INTROSPECTION_URL=https://keycloak.example.internal/realms/local/protocol/openid-connect/token/introspect
NIFI_OAUTH_CLIENT_ID=nifi-mcp
NIFI_OAUTH_CLIENT_SECRET=
NIFI_OAUTH_AUDIENCE=https://nifi-mcp.example.internal/mcp
# Add any named client scopes required by your identity/groups mappers.
NIFI_OAUTH_SCOPES='["openid", "profile", "email"]'
# Match NiFi's nifi.security.user.oidc.claim.identifying.user and claim.groups.
NIFI_OAUTH_IDENTITY_CLAIM=preferred_username
NIFI_OAUTH_GROUPS_CLAIM=groups
# Dedicated proxy certificate trusted by NiFi; authorize its identity for /proxy only.
NIFI_PROXY_CERT=/etc/nifi-mcp/proxy.crt
NIFI_PROXY_KEY=/etc/nifi-mcp/proxy.key
NIFI_CA_BUNDLE=/etc/nifi-mcp/internal-ca.pem
NIFI_TLS_VERIFY=true
# Writes are on; NiFi authorizes each user. Set true for an additional write restriction.
NIFI_READONLY=false

# Personal stdio instead: NIFI_AUTH=bearer, NIFI_TRANSPORT=stdio,
# NIFI_BEARER_TOKEN from YOUR NiFi login; unset NIFI_PROXY_CERT and NIFI_PROXY_KEY.
# OAuth discovery does not apply to stdio. Do not commit a personal token.
# Password login remains explicit and stdio-only:
# NIFI_AUTH=jwt + NIFI_USERNAME + NIFI_PASSWORD (NiFi /access/token), or
# NIFI_AUTH=oidc + NIFI_OIDC_TOKEN_URL + NIFI_OIDC_CLIENT_ID +
# NIFI_OIDC_CLIENT_SECRET + NIFI_OIDC_USERNAME + NIFI_OIDC_PASSWORD.
# No credentials are automatically fetched from Vault.
